# Copy these into Vercel → Project → Settings → Environment Variables
# (Production). Do NOT commit real secrets.

# --- Required for your UI ---
IS_GENERAL=true
NX_ADD_PLUGINS=false
SKIP_AUTH=true
NEXT_PUBLIC_SKIP_AUTH=true
NOT_SECURED=true

# After Vercel gives you a URL (e.g. https://your-app.vercel.app):
FRONTEND_URL=https://PASTE_VERCEL_URL
MAIN_URL=https://PASTE_VERCEL_URL

# After Railway gives you the backend URL (e.g. https://your-api.up.railway.app):
# Must be set BEFORE rebuild so NEXT_PUBLIC_* is baked into the client bundle.
NEXT_PUBLIC_BACKEND_URL=https://PASTE_RAILWAY_URL
BACKEND_INTERNAL_URL=https://PASTE_RAILWAY_URL

JWT_SECRET=use-same-value-as-railway
STORAGE_PROVIDER=local
