# Copy to .env and fill placeholders. Same keys go into Railway Variables.

DATABASE_URL="PASTE_NEON_DATABASE_URL_HERE"
REDIS_URL="PASTE_UPSTASH_REDIS_URL_HERE"

TEMPORAL_ADDRESS="PASTE_TEMPORAL_ADDRESS_HERE"
TEMPORAL_NAMESPACE="PASTE_TEMPORAL_NAMESPACE_HERE"
TEMPORAL_API_KEY="PASTE_TEMPORAL_API_KEY_HERE"
TEMPORAL_TLS="true"

MAIN_URL="https://PASTE_RAILWAY_URL_HERE"
FRONTEND_URL="https://PASTE_RAILWAY_URL_HERE"
NEXT_PUBLIC_BACKEND_URL="https://PASTE_RAILWAY_URL_HERE/api"
BACKEND_INTERNAL_URL="http://localhost:3000"

JWT_SECRET="GENERATE_A_LONG_RANDOM_STRING"
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
DISALLOW_PLUS="true"
RUN_CRON="true"
API_LIMIT="30"
NX_ADD_PLUGINS="false"

STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"
