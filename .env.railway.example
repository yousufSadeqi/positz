# Copy these into Railway → Service → Variables
# (Do NOT commit real secrets.)

# --- Neon (required) ---
DATABASE_URL=postgresql://neondb_owner:npg_hInjGEPY94Hw@ep-small-bar-axr0we4d-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Redis (required) — your redis.io URL ---
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# --- Temporal OFF for now ---
DISABLE_TEMPORAL=true
RUN_CRON=false

# --- Auth bypass until your own auth ---
SKIP_AUTH=true
NEXT_PUBLIC_SKIP_AUTH=true
NOT_SECURED=true

# --- URLs (set after both deploys) ---
# Vercel frontend:
FRONTEND_URL=https://PASTE_VERCEL_URL
MAIN_URL=https://PASTE_VERCEL_URL
# This Railway service public URL (no /api suffix for Nest direct deploy):
NEXT_PUBLIC_BACKEND_URL=https://PASTE_RAILWAY_URL
BACKEND_INTERNAL_URL=http://localhost:$PORT

JWT_SECRET=generate-a-long-random-string
IS_GENERAL=true
DISABLE_REGISTRATION=false
DISALLOW_PLUS=true
API_LIMIT=30
NX_ADD_PLUGINS=false
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/tmp/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# Leave Temporal placeholders empty while DISABLE_TEMPORAL=true
# TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
